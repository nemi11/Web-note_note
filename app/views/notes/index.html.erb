<% provide :hide_layout_parts, true %>

<!-- ロゴ（application.css のスタイルを使う） -->
<header class="logo-header">
  <div class="logo">
    <%= link_to "Web Note", root_path, class: "logo-link" %>
  </div>
</header>


<!-- スライダー -->
<div class="slider">
  <div class="note-slide">
    <h3>Grammar Tip</h3>
    <p>Use present perfect for experiences.</p>
  </div>
  <div class="note-slide">
    <h3>Vocabulary</h3>
    <p>‘Serendipity’ means a happy accident.</p>
  </div>
  <div class="note-slide">
    <h3>Idiom</h3>
    <p>‘Break the ice’ means to start a conversation.</p>
  </div>
</div>

<!-- index専用CSS（スライダー部分だけ） -->
<style>
  .slider {
    display: flex;
    gap: 1em;
    overflow-x: auto;
    padding: 2em;
    margin-top: 2em;
    justify-content: center;
  }

  .note-slide {
    min-width: 220px;
    background-color: #f9f9f9;
    padding: 1em;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    font-family: "Hiragino Sans", "Noto Sans JP", sans-serif;
  }

  .note-slide h3 {
    font-size: 1.2em;
    margin-bottom: 0.5em;
    color: #333;
  }

  .note-slide p {
    font-size: 1em;
    color: #555;
  }
</style>

<!-- index専用JS（自動スクロール） -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const slider = document.querySelector(".slider");
    let scrollAmount = 0;
    setInterval(() => {
      scrollAmount += 220;
      if (scrollAmount >= slider.scrollWidth) scrollAmount = 0;
      slider.scrollTo({ left: scrollAmount, behavior: "smooth" });
    }, 3000);
  });
</script>