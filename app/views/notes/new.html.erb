<% provide :hide_layout_parts, true %>

<!-- ロゴだけのヘッダー -->
<header class="login-header header-center">
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
  <div class="logo">
    <%= link_to "Web Note", root_path, style: "text-decoration: none; color: white;" %>
  </div>
</header>

<!-- メインコンテンツ -->
<main class="note-form-container">
  <h1>ノート作成</h1>

  <%= form_with(model: @note, local: true) do |form| %>
    <div id="explanations">
      <h3>ノート項目を追加</h3>
      <p class="guide-text">＋ボタンを押して項目を追加してください</p>
    </div>

    <!-- 自由追加ボタン -->
    <div class="optional-buttons">
      <button type="button" id="add-extra-english" class="add-button">＋ 英文を追加</button>
      <button type="button" id="add-extra-translation" class="add-button">＋ 翻訳を追加</button>
      <button type="button" id="add-explanation" class="add-button">＋ 説明を追加</button>
      <button type="button" id="add-divider" class="add-button">＋ 仕切り線を追加</button>
    </div>

    <div class="actions">
      <%= form.submit "保存する", class: "submit-button" %>
    </div>
  <% end %>
</main>

<!-- JavaScript -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("explanations");

    function createBox(label, name, rows, placeholder) {
      const box = document.createElement("div");
      box.classList.add("explanation-box");
      box.innerHTML = `
        <h4>${label}</h4>
        <textarea name="note[${name}][]" rows="${rows}" placeholder="${placeholder}"></textarea>
        <button type="button" class="remove-button">✕ 削除</button>
      `;
      box.querySelector(".remove-button").addEventListener("click", () => {
        box.remove();
      });
      container.appendChild(box);
    }

    function createDivider() {
      const box = document.createElement("div");
      box.classList.add("divider-box");
      box.innerHTML = `
        <hr>
        <button type="button" class="remove-button">✕ 削除</button>
      `;
      box.querySelector(".remove-button").addEventListener("click", () => {
        box.remove();
      });
      container.appendChild(box);
    }

    document.getElementById("add-extra-english").addEventListener("click", () => {
      createBox("英文", "extra_english", 2, "英文を入力");
    });

    document.getElementById("add-extra-translation").addEventListener("click", () => {
      createBox("翻訳", "extra_translation", 2, "翻訳を入力");
    });

    document.getElementById("add-explanation").addEventListener("click", () => {
      createBox("説明文", "explanations", 3, "説明文を入力（Markdown対応）");
    });

    document.getElementById("add-divider").addEventListener("click", () => {
      createDivider();
    });
  });
</script>