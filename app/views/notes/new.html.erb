<!-- app/views/notes/new.html.erb -->
<%= form_with model: @note, local: true, data: { controller: "note-form" } do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title, required: true %>

  <%= f.label :tags %>
  <%= f.text_field :tags, required: true %>

  <div data-note-form-target="sections">
    <%= f.fields_for :sections do |section_form| %>
      <%= render "section_fields", f: section_form %>
    <% end %>
  </div>

  <button type="button" data-action="click->note-form#addSection">＋</button>

  <%= f.submit "保存" %>
<% end %>