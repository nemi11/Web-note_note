<% provide :hide_layout_parts, true %>

<header class="login-header header-center">
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
  <div class="logo">
    <%= link_to "Web Note", root_path, style: "text-decoration: none; color: white;" %>
  </div>
</header>

<main class="note-form-container">
  <h1>ノート作成</h1>

  <%= form_with model: @note, url: confirm_notes_path, method: :post do |f| %>
    <!-- タイトル -->
    <div class="explanation-box">
      <h4>タイトル</h4>
      <%= f.text_field :title, placeholder: "ノートのタイトルを入力", required: true %>
    </div>

    <!-- タグ入力欄 -->
    <div class="explanation-box" id="tags-container">
      <h4>タグ</h4>
      <%= f.text_field :tags, name: "note[tags][]", placeholder: "タグ1" %>
      <button type="button" id="add-tag" class="add-button">＋ タグを追加</button>
    </div>

    <!-- JSで追加されるコンテンツ -->
    <div id="explanations">
      <h3>ノート項目を追加</h3>
      <p class="guide-text">＋ボタンを押して項目を追加してください</p>
    </div>

    <!-- 自由追加ボタン -->
    <div class="optional-buttons">
      <button type="button" id="add-extra-english" class="add-button">＋ 英文を追加</button>
      <button type="button" id="add-extra-translation" class="add-button">＋ 翻訳を追加</button>
      <button type="button" id="add-explanation" class="add-button">＋ 説明を追加</button>
      <button type="button" id="add-divider" class="add-button">＋ 仕切り線を追加</button>
    </div>

    <!-- 確認ボタン -->
    <div class="actions">
      <%= f.submit "確認", class: "submit-button" %>
    </div>
  <% end %>
</main>

<!-- Marked.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("explanations");

  function createBox(label, name, rows, value = "") {
    const box = document.createElement("div");
    box.classList.add("explanation-box");
    box.innerHTML = `
      <h4>${label}</h4>
      <textarea name="note[${name}][]" rows="${rows}" placeholder="${label}を入力" required>${value}</textarea>
      <div class="markdown-preview"></div>
      <button type="button" class="remove-button">✕ 削除</button>
    `;
    const textarea = box.querySelector("textarea");
    const preview = box.querySelector(".markdown-preview");

    // Markdownプレビュー
    function updatePreview() {
      preview.innerHTML = marked.parse(textarea.value || "");
    }
    textarea.addEventListener("input", updatePreview);
    updatePreview();

    box.querySelector(".remove-button").addEventListener("click", () => box.remove());
    container.appendChild(box);
  }

  function createDivider() {
    const box = document.createElement("div");
    box.classList.add("divider-box");
    box.innerHTML = `
      <hr>
      <input type="hidden" name="note[divider][]" value="1">
      <button type="button" class="remove-button">✕ 削除</button>
    `;
    box.querySelector(".remove-button").addEventListener("click", () => box.remove());
    container.appendChild(box);
  }

  // 初期データ
  const existingEnglish = <%= raw(@note.extra_english.to_json || '[]') %>;
  existingEnglish.forEach(text => createBox("英文", "extra_english", 2, text));

  const existingTranslation = <%= raw(@note.extra_translation.to_json || '[]') %>;
  existingTranslation.forEach(text => createBox("翻訳", "extra_translation", 2, text));

  const existingExplanations = <%= raw(@note.explanations.to_json || '[]') %>;
  existingExplanations.forEach(text => createBox("説明文", "explanations", 3, text));

  // ボタン操作
  document.getElementById("add-extra-english").addEventListener("click", () => {
    createBox("英文", "extra_english", 2);
  });

  document.getElementById("add-extra-translation").addEventListener("click", () => {
    createBox("翻訳", "extra_translation", 2);
  });

  document.getElementById("add-explanation").addEventListener("click", () => {
    createBox("説明文", "explanations", 3);
  });

  document.getElementById("add-divider").addEventListener("click", () => createDivider());

  // タグ追加
  document.getElementById("add-tag").addEventListener("click", () => {
    const input = document.createElement("input");
    input.type = "text";
    input.name = "note[tags][]";
    input.placeholder = "タグを追加";
    document.getElementById("tags-container").appendChild(input);
  });
});
</script>

<!-- CSS -->
<style>
.note-form-container {
  max-width: 720px;
  margin: 3em auto;
  padding: 2.5em;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  font-family: "Hiragino Sans", "Noto Sans JP", sans-serif;
}
.note-form-container h1 { text-align:center; margin-bottom:1.5em; font-size:1.8rem; font-weight:700; color:#222; }
.note-form-container .guide-text { font-size:0.95em; color:#666; margin-bottom:1.2em; text-align:center; }
.note-form-container .explanation-box { margin-bottom:1.2em; padding:1em 1.2em; border:1px solid #ddd; border-radius:10px; background:#fafafa; position:relative; }
.note-form-container .explanation-box h4 { margin-bottom:0.6em; font-size:1rem; color:#333; }
.note-form-container .explanation-box textarea,
.note-form-container .explanation-box input[type="text"] {
  width:100%; padding:0.6em; border:1px solid #ccc; border-radius:6px; font-size:0.95em; font-family:inherit; resize:vertical;
}
.note-form-container .markdown-preview { border:1px solid #eee; background:#fff; padding:0.6em; border-radius:6px; margin-top:0.6em; font-size:0.95em; color:#333; }
.note-form-container .divider-box { margin:2em 0; position:relative; }
.note-form-container .divider-box hr { border:none; border-top:1px solid #ccc; }
.note-form-container .remove-button { position:absolute; top:6px; right:10px; background:#111; color:white; border:none; padding:0.4em 0.8em; border-radius:5px; font-size:0.8em; cursor:pointer; transition:0.2s; }
.note-form-container .remove-button:hover { background:#333; }
.note-form-container .optional-buttons { display:flex; flex-wrap:wrap; justify-content:center; gap:0.8em; margin:1.8em 0; }
.note-form-container .add-button { padding:0.6em 1.2em; background:#000; color:#fff; border:none; border-radius:6px; cursor:pointer; font-size:0.95em; transition:0.2s; }
.note-form-container .add-button:hover { background:#333; transform:translateY(-2px); }
.note-form-container .submit-button { display:block; margin:2em auto 0; padding:0.8em 2em; background:#000; color:#fff; border:none; border-radius:8px; font-size:1.05em; font-weight:600; cursor:pointer; transition:0.2s; }
.note-form-container .submit-button:hover { background:#222; transform:translateY(-2px); }
</style>
