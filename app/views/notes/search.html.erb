<% provide :hide_layout_parts, true %>

<header class="logo-header">
  <div class="logo">
    <%= link_to "Web Note", root_path, class: "logo-link" %>
  </div>
</header>

<main class="search-results">
  <h2>検索結果</h2>

  <% def extract_match(array, query)
       return "" if array.blank? || query.blank?
       match = array.find { |text| text.include?(query) }
       match ? highlight(truncate(match, length: 100), query) : truncate(array.first.to_s, length: 100)
     end %>

  <% if @notes.present? %>
    <ul class="note-list">
      <% @notes.each do |note| %>
        <li class="note-item">
          <%= link_to note_path(note), class: "note-link" do %>
            <h3 class="note-title"><%= note.title %></h3>

            <% if note.extra_english.present? %>
              <div class="note-body">
                <div class="note-preview">
                  <%= extract_match(note.extra_english, @query.to_s) %>
                </div>
                <div class="note-full">
                  <%= simple_format(highlight(note.extra_english.join("\n"), @query.to_s)) %>
                </div>
              </div>
            <% end %>

            <% if note.extra_translation.present? %>
              <div class="note-body">
                <div class="note-preview">
                  <%= extract_match(note.extra_translation, @query.to_s) %>
                </div>
                <div class="note-full">
                  <%= simple_format(highlight(note.extra_translation.join("\n"), @query.to_s)) %>
                </div>
              </div>
            <% end %>

            <% if note.tags.reject(&:blank?).any? %>
              <p class="note-tags">タグ: <%= note.tags.reject(&:blank?).join(", ") %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="pagination">
      <%= paginate @notes %>
    </div>
  <% else %>
    <p class="no-results">該当するノートは見つかりませんでした。</p>
  <% end %>
</main>

<style>
  :root {
    --main-color: #8acde3;
    --highlight-color: #fff3a0;
  }

  body {
    margin: 0;
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    background-color: #fefefe;
  }

  .logo-header {
    background-color: var(--main-color);
    text-align: center;
    padding: 1em 2em;
  }

  .logo {
    display: inline-block;
  }

  .logo a,
  .logo-link {
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.4em;
    font-family: "Hiragino Sans", "Noto Sans JP", sans-serif;
  }

  .search-results {
    padding: 2em;
    max-width: 800px;
    margin: 0 auto;
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 2em 0;
  }

  .note-item {
    background-color: #f9f9f9;
    padding: 1em;
    margin-bottom: 1.5em;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }

  .note-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .note-title {
    font-size: 1.2em;
    margin-bottom: 0.5em;
    color: #333;
  }

  .note-body {
    margin: 0.3em 0;
  }

  .note-preview {
    font-size: 1em;
    color: #555;
  }

  .note-full {
    display: none;
    font-size: 1em;
    color: #333;
    white-space: pre-wrap;
    margin-top: 0.3em;
  }

  .note-item:hover .note-preview {
    display: none;
  }

  .note-item:hover .note-full {
    display: block;
  }

  .note-tags {
    font-size: 0.9em;
    color: #888;
    margin-top: 0.5em;
  }

  .no-results {
    text-align: center;
    font-size: 1.1em;
    color: #666;
  }

  .pagination {
    text-align: center;
    margin-top: 2em;
  }

  .pagination a,
  .pagination span {
    display: inline-block;
    margin: 0 4px;
    padding: 6px 12px;
    border-radius: 4px;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.2s ease;
  }

  .pagination a:hover {
    background-color: #333;
  }

  .pagination .current {
    background-color: #333;
    color: #fff;
  }

  mark {
    background-color: var(--highlight-color);
    font-weight: bold;
  }
</style>