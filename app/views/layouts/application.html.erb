<!DOCTYPE html>
<html>
  <head>
    <title>English Note Hub</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- 共通 CSS -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :page_css %>

    <!-- 共通 JS -->
    <%= javascript_importmap_tags %>
    <%= yield :page_js %>
  </head>

  <body>
    <div class="page-wrapper">

      <% unless content_for?(:hide_layout_parts) %>
        <!-- ヘッダー -->
        <header>
          <div class="header-center">
            <div class="search-group">
              <div class="logo">
                <%= link_to "Web Note", root_path, style: "text-decoration: none; color: white; font-weight: bold;" %>
              </div>

              <div class="search-box">
                <form action="/notes/search" method="get">
                  <input type="text" name="q" placeholder="タイトル・タグ・本文から検索">
                  <button type="submit">Search</button>
                </form>
              </div>
            </div>
          </div>

          <div class="header-light">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

            <% if user_signed_in? %>
              <i class="fa-solid fa-bell"></i>
              <i class="fa-solid fa-heart"></i>
              <div class="menu-icon">
                <%= render "layouts/menu" %>
                <%= link_to "ノート作成", new_note_path, class: "btn btn-primary" %>
                <%= link_to 'ログアウト', logout_path, method: :delete, data: { confirm: 'ログアウトしますか？' }, class: 'nav__logout-button' %>
              </div>
            <% else %>
              <% if defined?(custom_signup_path) %>
                <%= link_to "会員登録", custom_signup_path %>
              <% end %>
              <%= link_to "ログイン", login_path %>
            <% end %>
          </div>
        </header>

        <!-- フラッシュメッセージ -->
        <% flash.each do |key, value| %>
          <div class="flash-message flash-<%= key %>"><%= value %></div>
        <% end %>
      <% end %>

      <!-- メインコンテンツ -->
      <main>
        <%= yield %>
      </main>

      <% unless content_for?(:hide_layout_parts) %>
        <!-- フッター -->
        <footer class="site-footer">
          <div class="footer-links">
            <a href="/terms">利用規約</a>
            <span>|</span>
            <a href="/privacy">プライバシーポリシー</a>
          </div>
          <p class="copyright">© 2025 Web Note</p>
        </footer>
      <% end %>

    </div>

    <!-- 👇 応急処置用のJSをここに直接書く -->
    <!-- 👇 応急処置JS -->
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        console.log("応急JSロード完了");

        // メニュートグルボタン
        const menuButton = document.querySelector(".menu-button");
        const menuWrapper = document.querySelector(".menu-wrapper");

        if (menuButton && menuWrapper) {
          menuButton.addEventListener("click", function() {
            const expanded = this.getAttribute("aria-expanded") === "true";
            this.setAttribute("aria-expanded", !expanded);
            menuWrapper.classList.toggle("open"); // CSSで.open時の見た目を制御する
          });
        }

        // ツールチップ表示（hover時）
        const menuItems = document.querySelectorAll(".menu-item");
        menuItems.forEach((item) => {
          const tooltip = item.querySelector(".tooltip");
          if (!tooltip) return;

          item.addEventListener("mouseenter", () => {
            tooltip.classList.remove("hidden");
          });
          item.addEventListener("mouseleave", () => {
            tooltip.classList.add("hidden");
          });
        });
      });
    </script>
  </body>
</html>
