<div class="login-page">
  <h1>ログイン</h1>

  <% if flash[:notice] %>
    <div class="flash-notice"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert] %>
    <div class="flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: login_path, method: :post, local: true, html: { class: "login-form" } do |f| %>
    <div class="form-group">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password %>
    </div>

    <div class="form-group">
      <%= f.submit "ログイン", class: "submit-button" %>
    </div>
  <% end %>
</div>
